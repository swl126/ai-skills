{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/schema/embedded-skills.schema.json",
  "title": "Embedded AI Skills Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "distribution", "skills"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "distribution": {"const": "embedded"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "path": {"type": "string", "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$"},
          "status": {"const": "embedded"}
        }
      }
    }
  }
}
