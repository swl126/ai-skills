{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/schema/catalog.schema.json",
  "title": "AI Skills Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "owner", "license", "skills"],
  "properties": {
    "$schema": {"type": "string"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "minLength": 1},
    "license": {"const": "GPL-3.0-or-later"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "repository", "entrypoint", "category", "status", "license", "validation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^https://github\\.com/swl126/[A-Za-z0-9_.-]+$"},
          "entrypoint": {"const": "SKILL.md"},
          "category": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "validated", "deprecated"]},
          "license": {"const": "GPL-3.0-or-later"},
          "validation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
