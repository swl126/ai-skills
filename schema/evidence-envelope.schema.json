{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/schema/evidence-envelope.schema.json",
  "title": "AI Skills Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "target", "collector", "collected_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "environment"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "method"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "collected_at": {"type": "string", "format": "date-time"}
  }
}
