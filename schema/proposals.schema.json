{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/schema/proposals.schema.json",
  "title": "Proposed AI Skills",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_version", "owner", "proposals"],
  "properties": {
    "$schema": {"type": "string"},
    "proposal_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"const": "swl126"},
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "id", "category", "status", "description"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"const": "proposed"},
          "description": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
