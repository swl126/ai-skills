{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/schema/endgame.schema.json",
  "title": "ENDGAME Repository Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "canonical_skill", "repository", "repository_version", "required_gates", "latest_audit"],
  "properties": {
    "$schema": {"type": "string"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "canonical_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "commit", "entrypoint"],
      "properties": {
        "repository": {"const": "https://github.com/swl126/endgame"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "entrypoint": {"const": "SKILL.md"}
      }
    },
    "repository": {"const": "https://github.com/swl126/ai-skills"},
    "repository_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "latest_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "result", "validated_skill_count", "proposal_count", "test_count"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "result": {"enum": ["pass", "blocked", "fail"]},
        "validated_skill_count": {"type": "integer", "minimum": 0},
        "proposal_count": {"type": "integer", "minimum": 0},
        "test_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
