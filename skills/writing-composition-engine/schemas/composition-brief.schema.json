{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing Composition Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "audience", "purpose", "genre", "sections", "sources"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "genre": {"enum": ["academic", "technical", "technical-memo", "policy", "proposal", "executive"]},
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "paragraphs", "claims"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "paragraphs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "evidence_ids"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "verified"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "citation": {"type": "string", "minLength": 1},
          "verified": {"type": "boolean"}
        }
      }
    }
  }
}
