{
  "$schema": "../../schema/skill-package.schema.json",
  "id": "model-evaluation-harness",
  "version": "1.1.0",
  "distribution": "embedded",
  "license": "GPL-3.0-or-later",
  "entrypoint": "SKILL.md",
  "resources": {
    "playbook": "references/playbook.md",
    "report_template": "assets/report-template.md",
    "example_request": "examples/request.md",
    "example_output": "examples/expected-output.md",
    "example_report": "examples/example-report.md",
    "agent_metadata": "agents/openai.yaml"
  },
  "validation": {
    "command": "python3 scripts/validate_report.py REPORT.md",
    "test_command": "python3 tests/test_validate_report.py"
  },
  "execution": {
    "runtime": "python>=3.10",
    "network": "none",
    "filesystem": {
      "read": "package-and-user-supplied-inputs",
      "write": "explicit-output-paths-only"
    },
    "external_writes": false,
    "destructive": false
  },
  "extensions": {
    "executable": "scripts/eval_harness.py",
    "test": "tests/test_eval_harness.py",
    "reference": "references/evaluation-contract.md",
    "schemas": [
      "schemas/evaluation-spec.schema.json",
      "schemas/evaluation-case.schema.json",
      "schemas/system-output.schema.json",
      "schemas/score-result.schema.json"
    ],
    "fixtures": [
      "examples/fixtures/spec.json",
      "examples/fixtures/cases.jsonl",
      "examples/fixtures/baseline.outputs.jsonl",
      "examples/fixtures/candidate.outputs.jsonl"
    ]
  }
}
