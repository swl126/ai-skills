{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/skills/model-evaluation-harness/schemas/score-result.schema.json",
  "title": "Evaluation Score Result",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "system_id", "generated_at", "spec_sha256", "cases_sha256", "outputs_sha256", "decision", "summary", "slices", "case_results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evaluation_id": {"type": "string"},
    "system_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["PASS", "BLOCK"]},
    "threshold_failures": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "object"},
    "slices": {"type": "object"},
    "case_results": {"type": "array", "minItems": 1}
  }
}
