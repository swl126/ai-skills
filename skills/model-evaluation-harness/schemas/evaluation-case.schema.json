{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swl126/ai-skills/blob/main/skills/model-evaluation-harness/schemas/evaluation-case.schema.json",
  "title": "Evaluation Case JSONL Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slice", "input", "checks"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "slice": {"type": "string", "minLength": 1},
    "critical": {"type": "boolean", "default": false},
    "weight": {"type": "number", "exclusiveMinimum": 0, "default": 1},
    "input": {},
    "metadata": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["exact", "contains_all", "contains_none", "regex", "json_valid", "json_fields", "max_chars", "latency_ms_max", "cost_usd_max", "manual_score"]},
          "value": {},
          "values": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "pattern": {"type": "string"},
          "flags": {"type": "string", "pattern": "^[im]*$"},
          "required": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "min_score": {"type": "number", "minimum": 0, "maximum": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "case_sensitive": {"type": "boolean"}
        }
      }
    }
  }
}
