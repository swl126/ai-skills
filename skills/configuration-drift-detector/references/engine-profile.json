{
  "schema_version": "1.0.0",
  "skill_id": "configuration-drift-detector",
  "title": "Configuration Drift Engine",
  "max_evidence_age_days": 30,
  "required_categories": [
    "identity",
    "logging",
    "encryption",
    "network",
    "application"
  ],
  "block_severities": [
    "critical",
    "high"
  ],
  "review_severities": [
    "medium"
  ],
  "rules": [
